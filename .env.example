NEXT_PUBLIC_SUPABASE_URL="https://pukvrerdloudfiphomsj.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_WHATSAPP_NUMBER=""
SUPABASE_PROJECT_REF="pukvrerdloudfiphomsj"

# Server only. Keep disabled until schema, accounts, commercial terms and sandbox acceptance are validated.
FEDAPAY_ENABLED=false
# Admission switch: keep processing enabled for existing payments when suspending new orders.
PAYMENT_CHECKOUT_ENABLED=false
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# Trusted HTTPS origin: production domain or isolated acceptance preview.
PAYMENT_SITE_URL=
PAYMENT_RECONCILE_SECRET=
EVENT_REQUESTS_ENABLED=false
EVENT_REQUEST_RATE_SECRET=

# Enable only after atomic-order migration and Edge Function deployment.
OPERATIONS_ATOMIC_ENABLED=false

# Commerce payment rollout (all server-only). No defaults for commercial terms.
FEDAPAY_ACCOUNT_ID=
FEDAPAY_LIVE_APPROVED=false
# Sandbox commerce MUST use a separate database/project, not production.
PAYMENT_DATABASE_ISOLATED=false
# Exact approved flat delivery fee in XOF, including an explicit 0 if approved.
PAYMENT_SHIPPING_XOF=
# Optional actual email delivery; without these jobs wait and admin remains the notification channel.
RESEND_API_KEY=
ORDER_EMAIL_FROM=
ORDER_ADMIN_EMAIL=

# PR #11 private Live acceptance ONLY. Disabled until owner prerequisites/approval.
PAYMENT_LIVE_TEST_ENABLED=false
# Approved ceiling in XOF, hard upper limit 1000. No default financial amount.
PAYMENT_LIVE_TEST_MAX_XOF=
# One-shot authorization UUID, prepared only AFTER owner approval in recette DB.
PAYMENT_LIVE_TEST_AUTHORIZATION_ID=
